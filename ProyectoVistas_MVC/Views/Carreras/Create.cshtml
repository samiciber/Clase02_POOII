@model ProyectoVistas_MVC.Models.Carrera
@{
    ViewBag.Title = "Crear Nueva Carrera";
}

<div class="wrapper">
    <h2 style="color: #003d82; margin-bottom: 30px;">Crear Nueva Carrera</h2>

    @using (Html.BeginForm("Create", "Carreras", FormMethod.Post, new { @class = "form-horizontal" }))
    {
        @Html.AntiForgeryToken()

        <div style="background-color: #f9f9f9; padding: 30px; border-radius: 8px;">

            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

            <!-- Nombre -->
            <div class="form-group" style="margin-bottom: 20px;">
                @Html.LabelFor(model => model.Nombre, htmlAttributes: new { @class = "control-label col-md-2", @style = "font-weight: bold;" })
                <div class="col-md-10">
                    @Html.EditorFor(model => model.Nombre, new { htmlAttributes = new { @class = "form-control", @placeholder = "Ej: Ingeniería de Sistemas" } })
                    @Html.ValidationMessageFor(model => model.Nombre, "", new { @class = "text-danger" })
                </div>
            </div>

            <!-- Descripción -->
            <div class="form-group" style="margin-bottom: 20px;">
                @Html.LabelFor(model => model.Descripcion, htmlAttributes: new { @class = "control-label col-md-2", @style = "font-weight: bold;" })
                <div class="col-md-10">
                    @Html.TextAreaFor(model => model.Descripcion, 5, 50, new { @class = "form-control", @placeholder = "Descripción detallada de la carrera..." })
                    @Html.ValidationMessageFor(model => model.Descripcion, "", new { @class = "text-danger" })
                </div>
            </div>

            <!-- Duración -->
            <div class="form-group" style="margin-bottom: 20px;">
                @Html.LabelFor(model => model.Duracion, htmlAttributes: new { @class = "control-label col-md-2", @style = "font-weight: bold;" })
                <div class="col-md-10">
                    @Html.EditorFor(model => model.Duracion, new { htmlAttributes = new { @class = "form-control", @type = "number", @min = "1", @max = "5" } })
                    @Html.ValidationMessageFor(model => model.Duracion, "", new { @class = "text-danger" })
                </div>
            </div>

            <!-- Modalidad -->
            <div class="form-group" style="margin-bottom: 20px;">
                @Html.LabelFor(model => model.Modalidad, htmlAttributes: new { @class = "control-label col-md-2", @style = "font-weight: bold;" })
                <div class="col-md-10">
                    @Html.DropDownListFor(model => model.Modalidad,
                        new SelectList(new[] { "Presencial", "Online", "Presencial / Online" }),
                        "-- Seleccione --",
                        new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.Modalidad, "", new { @class = "text-danger" })
                </div>
            </div>

            <!-- URL Imagen -->
            <div class="form-group" style="margin-bottom: 20px;">
                @Html.LabelFor(model => model.ImagenUrl, htmlAttributes: new { @class = "control-label col-md-2", @style = "font-weight: bold;" })
                <div class="col-md-10">
                    @Html.EditorFor(model => model.ImagenUrl, new { htmlAttributes = new { @class = "form-control", @placeholder = "~/imagenes/nombre.jpg" } })
                    @Html.ValidationMessageFor(model => model.ImagenUrl, "", new { @class = "text-danger" })
                </div>
            </div>

            <!-- Botones -->
            <div class="form-group">
                <div class="col-md-offset-2 col-md-10">
                    <button type="submit" class="btn" style="background-color: #005bb5; color: white; padding: 10px 30px; border: none; border-radius: 5px; font-weight: bold;">
                        Crear Carrera
                    </button>
                    @Html.ActionLink("Cancelar", "Index", null, new { @class = "btn", @style = "background-color: #6c757d; color: white; padding: 10px 30px; text-decoration: none; border-radius: 5px; margin-left: 10px;" })
                </div>
            </div>

        </div>
    }
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <script>$(document).ready(function() {
            // Mostrar vista previa de la imagen
            $('#ImagenUrl').on('input', function() {
                var url = $(this).val();
                if(url) {
                    $('#preview').remove();
                    $(this).parent().append(
                        '<img id="preview" src="' + url + '" style="max-width: 200px; margin-top: 10px; border-radius: 5px;" />'
                    );
                }
            });
        });
    </script>
}